<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- auxForever price history sync between WoW accounts: runs sync.lua whenever a game saves.
     Turn off: launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/no.auxforever.sync.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>no.auxforever.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/lua</string>
        <string>/Users/marcus/Library/Application Support/auxForever-sync/sync.lua</string>
        <string>/Applications/World of Warcraft/_forever_/WTF/Account</string>
    </array>
    <!-- the folders, not the files: WoW replaces auxForever.lua when it saves -->
    <key>WatchPaths</key>
    <array>
        <string>/Applications/World of Warcraft/_forever_/WTF/Account/446821491#1/SavedVariables</string>
        <string>/Applications/World of Warcraft/_forever_/WTF/Account/446821491#2/SavedVariables</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/marcus/Library/Application Support/auxForever-sync/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/marcus/Library/Application Support/auxForever-sync/launchd.log</string>
</dict>
</plist>
